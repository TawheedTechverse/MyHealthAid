# Copy to server/.env and fill in real values.

PORT=4000

# Postgres connection string. Works with a local install or a hosted provider
# (Neon, Supabase, Railway, etc.).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myhealthaid

# Set to "true" when your provider requires SSL (most hosted Postgres do).
PG_SSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the React app is served from (for CORS).
CLIENT_ORIGIN=http://localhost:5173

# --- Visit-note summarization (optional) ---
# Without a key, doctors can still record and save transcripts; the AI summary
# step is skipped and can be run later once a key is set.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used to turn a transcript into a structured clinical summary.
# "gemini-flash-latest" tracks Google's current fast model automatically.
# Pin an exact snapshot (e.g. gemini-3.8-flash) if you want it to stop moving.
SUMMARY_MODEL=gemini-flash-latest
